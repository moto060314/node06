<div id="signin-modal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal('signin-modal')">&times;</span>
    <h2>Sign In</h2>
    <form id="signin-form">
      <div class="form-group">
        <label for="signin-email">Email</label>
        <input type="email" id="signin-email" name="email" required autocomplete="off"/>
      </div>
      <div class="form-group">
        <label for="signin-password">Password</label>
        <input type="password" id="signin-password" name="password" required autocomplete="off"/>
      </div>
      <button type="submit" class="btn-primary">Login</button>
    </form>
    <p class="error-message" id="signin-error"></p>
  </div>
</div>

<div id="add-reaction-type-modal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal('add-reaction-type-modal')">&times;</span>
    <h2>Add New Reaction</h2>
    <form id="add-reaction-type-form">
      <div class="form-group">
        <label for="reaction-name">Reaction Name</label>
        <input type="text" id="reaction-name" name="name" placeholder="e.g. Party Parrot" required autocomplete="off"/>
      </div>
      <div class="form-group">
        <label for="reaction-image">Image</label>
        <input type="file" id="reaction-image" name="image" accept="image/*" required autocomplete="off"/>
      </div>
      <button type="submit" class="btn-primary">Create Reaction</button>
    </form>
    <p class="error-message" id="reaction-type-error"></p>
  </div>
</div>

<div class="timeline" id="timeline-container">
  <h2>Timeline</h2>

  <% if (posts && posts.length > 0) { %> <% posts.forEach(post => { %>
  <div class="post-card" data-user-id="<%= post.user_id %>" data-post-id="<%= post.id %>">
    <div class="post-header">
      <div class="post-user-info">
        <% if (post.profile_image_url) { %>
        <img src="<%= post.profile_image_url %>" alt="<%= post.username %>" class="post-avatar" />
        <% } else { %>
        <div class="post-avatar-placeholder"><%= post.username.charAt(0).toUpperCase() %></div>
        <% } %>
        <span class="post-username"><%= post.username %></span>
      </div>
      <span class="post-date"> <%= new Date(post.created_at).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %> </span>
    </div>
    <div class="post-content">
      <p><%= post.content %></p>
      <% if (post.image_url) { %>
      <div class="post-image-container">
        <img src="<%= post.image_url %>" alt="Post Image" class="post-image" />
      </div>
      <% } %>
    </div>

    <div class="post-reactions" id="reactions-<%= post.id %>">
      <% if (post.reactions) { %> <% post.reactions.forEach(reaction => { %> <% const isReactedByMe = user && reaction.user_ids.includes(user.id); %>
      <div class="reaction-badge <%= isReactedByMe ? 'reacted' : '' %>" onclick="toggleReaction('<%= post.id %>', '<%= reaction.type_id %>')" data-title="<%= reaction.name %>">
        <img src="<%= reaction.image_url %>" alt="<%= reaction.name %>" />
        <span><%= reaction.count %></span>
      </div>
      <% }) %> <% } %>
      <button class="btn-add-reaction" onclick="openReactionPicker('<%= post.id %>')">+</button>
    </div>
  </div>
  <% }); %> <% } else { %>
  <p id="no-posts-msg" class="no-posts-message">No posts yet. Start doing something!</p>
  <% } %>
</div>
